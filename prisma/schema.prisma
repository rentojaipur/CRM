// EduFlow ERP — multi-tenant Education CRM + Admission ERP
// Every tenant-scoped model carries `instituteId`. Application-layer tenant
// scoping (see src/lib/prisma.ts) auto-filters queries by the active institute.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Platform / Tenancy ──────────────────────────────────────────────

enum InstitutePlan {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum InstituteStatus {
  ACTIVE
  SUSPENDED
  TRIAL
}

model Institute {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  address        String?
  gstNumber      String?
  contactEmail   String?
  contactPhone   String?
  logoUrl        String?
  plan           InstitutePlan   @default(TRIAL)
  status         InstituteStatus @default(TRIAL)
  maxUsers       Int             @default(10)
  maxStudents    Int             @default(500)
  storageLimitMb Int             @default(1024)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  branches               Branch[]
  users                  User[]
  roles                  Role[]
  courses                Course[]
  leads                  Lead[]
  students               Student[]
  admissions             Admission[]
  approvalRequests       ApprovalRequest[]
  feeTransactions        FeeTransaction[]
  documents              Document[]
  batches                Batch[]
  inventoryItems         InventoryItem[]
  inventoryIssues        InventoryIssue[]
  communicationTemplates CommunicationTemplate[]
  notifications          Notification[]
  auditLogs              AuditLog[]

  @@map("institutes")
}

model Branch {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  address     String?
  createdAt   DateTime  @default(now())

  users    User[]
  leads    Lead[]
  students Student[]
  batches  Batch[]

  @@index([instituteId])
  @@map("branches")
}

// ── RBAC ─────────────────────────────────────────────────────────────

model Role {
  id          String     @id @default(cuid())
  instituteId String? // null = system role (e.g. SUPER_ADMIN)
  institute   Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name        String
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())

  users           User[]
  rolePermissions RolePermission[]

  @@unique([instituteId, name])
  @@index([instituteId])
  @@map("roles")
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique // e.g. "student.edit", "fee.edit", "scholarship.change"
  label  String
  module String // grouping for the permission-builder UI, e.g. "Student", "Fee"

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  allowed      Boolean    @default(false)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(cuid())
  instituteId  String? // null = Super Admin
  institute    Institute? @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?    @relation(fields: [branchId], references: [id])
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  name         String
  email        String     @unique
  phone        String?
  passwordHash String
  isActive     Boolean    @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())

  assignedLeads           Lead[]            @relation("LeadAssignee")
  createdFollowups        Followup[]
  counselledAdmissions    Admission[]       @relation("AdmissionCounsellor")
  approvedAdmissions      Admission[]       @relation("AdmissionApprover")
  requestedApprovals      ApprovalRequest[] @relation("ApprovalRequester")
  reviewedApprovals       ApprovalRequest[] @relation("ApprovalReviewer")
  recordedFeeTransactions FeeTransaction[]
  uploadedDocuments       Document[]
  facultyBatches          Batch[]           @relation("BatchFaculty")
  issuedInventory         InventoryIssue[]
  notifications           Notification[]
  auditLogs               AuditLog[]

  @@index([instituteId])
  @@map("users")
}

// ── Courses & Batches ────────────────────────────────────────────────

model Course {
  id                    String    @id @default(cuid())
  instituteId           String
  institute             Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name                  String
  code                  String
  duration              String?
  mrpFee                Decimal   @db.Decimal(12, 2)
  maxScholarshipPercent Decimal   @default(0) @db.Decimal(5, 2)
  createdAt             DateTime  @default(now())

  admissions Admission[]
  batches    Batch[]

  @@unique([instituteId, code])
  @@index([instituteId])
  @@map("courses")
}

model Batch {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id])
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id])
  name        String
  startDate   DateTime?
  facultyId   String?
  faculty     User?     @relation("BatchFaculty", fields: [facultyId], references: [id])
  createdAt   DateTime  @default(now())

  students Student[]

  @@index([instituteId])
  @@map("batches")
}

// ── Student CRM: Leads → Followups → Admission → Student ────────────

enum LeadSource {
  WEBSITE
  WALK_IN
  GOOGLE
  FACEBOOK
  ANTHE
  REFERRAL
  OTHER
}

enum LeadStatus {
  NEW
  INTERESTED
  FOLLOWUP
  CONVERTED
  LOST
}

model Lead {
  id               String     @id @default(cuid())
  instituteId      String
  institute        Institute  @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId         String?
  branch           Branch?    @relation(fields: [branchId], references: [id])
  name             String
  fatherName       String?
  mobile           String
  email            String?
  dob              DateTime?
  school           String?
  class            String?
  source           LeadSource @default(OTHER)
  status           LeadStatus @default(NEW)
  assignedToUserId String?
  assignedTo       User?      @relation("LeadAssignee", fields: [assignedToUserId], references: [id])
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  followups Followup[]
  student   Student?

  @@index([instituteId])
  @@map("leads")
}

enum FollowupStatus {
  SCHEDULED
  DONE
  MISSED
}

model Followup {
  id               String         @id @default(cuid())
  leadId           String
  lead             Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  remark           String
  nextFollowupDate DateTime?
  status           FollowupStatus @default(SCHEDULED)
  createdByUserId  String
  createdBy        User           @relation(fields: [createdByUserId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([leadId])
  @@map("followups")
}

model Student {
  id           String    @id @default(cuid())
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  branchId     String?
  branch       Branch?   @relation(fields: [branchId], references: [id])
  leadId       String?   @unique
  lead         Lead?     @relation(fields: [leadId], references: [id])
  name         String
  fatherName   String?
  mobile       String
  email        String?
  dob          DateTime?
  school       String?
  class        String?
  rollNumber   String?
  batchId      String?
  batch        Batch?    @relation(fields: [batchId], references: [id])
  appActivated Boolean   @default(false)
  createdAt    DateTime  @default(now())

  admissions      Admission[]
  documents       Document[]
  feeTransactions FeeTransaction[]
  inventoryIssues InventoryIssue[]

  @@index([instituteId])
  @@map("students")
}

// ── Admission & Approval Workflow ────────────────────────────────────

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model Admission {
  id                 String         @id @default(cuid())
  instituteId        String
  institute          Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  studentId          String
  student            Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course         @relation(fields: [courseId], references: [id])
  totalFee           Decimal        @db.Decimal(12, 2)
  scholarshipPercent Decimal        @default(0) @db.Decimal(5, 2)
  scholarshipAmount  Decimal        @default(0) @db.Decimal(12, 2)
  discountReason     String?
  installmentPlan    Json?
  counsellorId       String?
  counsellor         User?          @relation("AdmissionCounsellor", fields: [counsellorId], references: [id])
  approvalStatus     ApprovalStatus @default(NOT_REQUIRED)
  approvedByUserId   String?
  approvedBy         User?          @relation("AdmissionApprover", fields: [approvedByUserId], references: [id])
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  approvalRequests ApprovalRequest[]
  feeTransactions  FeeTransaction[]

  @@index([instituteId])
  @@map("admissions")
}

enum ApprovalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Generic approval-request table — currently used for admission scholarship
// approvals, kept entity-agnostic (entityType/entityId) so other workflows
// (e.g. fee waivers) can reuse it without a schema change.
model ApprovalRequest {
  id                String                @id @default(cuid())
  instituteId       String
  institute         Institute             @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  entityType        String // e.g. "ADMISSION"
  entityId          String
  admissionId       String?
  admission         Admission?            @relation(fields: [admissionId], references: [id])
  ruleTriggered     String // e.g. "Scholarship > 30%"
  requestedByUserId String
  requestedBy       User                  @relation("ApprovalRequester", fields: [requestedByUserId], references: [id])
  status            ApprovalRequestStatus @default(PENDING)
  reviewedByUserId  String?
  reviewedBy        User?                 @relation("ApprovalReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())

  @@index([instituteId])
  @@map("approval_requests")
}

// ── Accounts ──────────────────────────────────────────────────────────

enum FeeTransactionMode {
  CASH
  ONLINE
  CHEQUE
  UPI
}

model FeeTransaction {
  id               String             @id @default(cuid())
  instituteId      String
  institute        Institute          @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  admissionId      String?
  admission        Admission?         @relation(fields: [admissionId], references: [id])
  amount           Decimal            @db.Decimal(12, 2)
  mode             FeeTransactionMode
  transactionRef   String?
  receiptNumber    String             @unique
  paidAt           DateTime           @default(now())
  dueDate          DateTime?
  recordedByUserId String
  recordedBy       User               @relation(fields: [recordedByUserId], references: [id])
  createdAt        DateTime           @default(now())

  @@index([instituteId])
  @@map("fee_transactions")
}

// ── Student Locker ────────────────────────────────────────────────────

enum DocumentType {
  PHOTO
  AADHAR
  MARKSHEET
  TC
  OTHER
}

model Document {
  id               String       @id @default(cuid())
  instituteId      String
  institute        Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  type             DocumentType
  fileUrl          String
  uploadedByUserId String
  uploadedBy       User         @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime     @default(now())

  @@index([instituteId])
  @@map("documents")
}

// ── Inventory ─────────────────────────────────────────────────────────

enum InventoryCategory {
  BOOK
  MODULE
  UNIFORM
  BAG
  TABLET
  OTHER
}

model InventoryItem {
  id              String            @id @default(cuid())
  instituteId     String
  institute       Institute         @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  name            String
  category        InventoryCategory
  sku             String?
  quantityInStock Int               @default(0)
  createdAt       DateTime          @default(now())

  issues InventoryIssue[]

  @@index([instituteId])
  @@map("inventory_items")
}

model InventoryIssue {
  id             String        @id @default(cuid())
  instituteId    String
  institute      Institute     @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  itemId         String
  item           InventoryItem @relation(fields: [itemId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id])
  quantityIssued Int
  issuedByUserId String
  issuedBy       User          @relation(fields: [issuedByUserId], references: [id])
  issuedAt       DateTime      @default(now())

  @@index([instituteId])
  @@map("inventory_issues")
}

// ── Communication Hub (Phase 2 — schema reserved now) ────────────────

enum CommunicationChannel {
  EMAIL
  SMS
  WHATSAPP
}

model CommunicationTemplate {
  id          String               @id @default(cuid())
  instituteId String
  institute   Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  channel     CommunicationChannel
  name        String
  subject     String?
  body        String
  createdAt   DateTime             @default(now())

  @@index([instituteId])
  @@map("communication_templates")
}

model Notification {
  id          String    @id @default(cuid())
  instituteId String
  institute   Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([instituteId])
  @@index([userId])
  @@map("notifications")
}

// ── Audit Log ─────────────────────────────────────────────────────────

model AuditLog {
  id           String    @id @default(cuid())
  instituteId  String
  institute    Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  action       String // e.g. "UPDATE", "CREATE", "DELETE"
  entityType   String // e.g. "Admission"
  entityId     String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  createdAt    DateTime  @default(now())

  @@index([instituteId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}
